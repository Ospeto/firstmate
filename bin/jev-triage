#!/usr/bin/env bash
# bin/jev-triage - CLI wrapper for Jev PR triage per captain preferences.
# Usage: jev-triage pr "<PR title, diff stat, summary of modified files>"
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

subcmd=${1:-}
shift || true

case "$subcmd" in
  pr)
    exec "$SCRIPT_DIR/fm-jev.sh" triage-pr "$@"
    ;;
  *)
    exec "$SCRIPT_DIR/fm-jev.sh" triage-pr "$subcmd" "$@"
    ;;
esac
